# 应用配置
DEBUG=false
HOST=0.0.0.0
PORT=8000

# LLM API密钥 (至少配置一个)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM配置
DEFAULT_MODEL=gemini-2.0-flash-exp
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=100000

# 记忆系统
MEMORY_DIR=memory

# 会话配置
SESSION_TIMEOUT=3600
MAX_SESSIONS=1000

# CORS配置 (生产环境)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-vercel-app.vercel.app,https://your-custom-domain.com

# 日志配置
LOG_LEVEL=INFO
